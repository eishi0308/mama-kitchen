@page "/kitchen/reviews"
@attribute [Authorize]
@inject ISellerService Sellers
@inject CurrentUserService CurrentUser
@implements IDisposable

@* The other half of the review system. Buyers could rate a cook, and the cook
   had no way to read it, let alone answer — a one-way rating is a scoreboard,
   not a reputation. *@

<PageTitle>Reviews — Batch</PageTitle>

@if (!CurrentUser.IsSeller)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="star" Size="26" /></div>
        <h3>No kitchen yet</h3>
        <p>Reviews of your cooking will show up here once you're selling.</p>
        <a class="btn btn-primary mt-2" href="/sell/start">Start selling</a>
    </div>
}
else if (_reviews is null)
{
    <div class="skeleton" style="height:320px;"></div>
}
else
{
    var profile = CurrentUser.CurrentUser.SellerProfile!;
    var unanswered = _reviews.Count(r => !r.IsAnswered);
    var needsAttention = _reviews.Count(r => r.NeedsAttention);

    <div class="page-header">
        <div>
            <h1>Reviews</h1>
            <div class="page-sub">
                @if (_reviews.Count == 0)
                {
                    <text>Nothing yet — your first review lands after someone collects a meal.</text>
                }
                else
                {
                    <text>@_reviews.Count total · @unanswered unanswered</text>
                }
            </div>
        </div>
        <div class="page-header-actions">
            <a class="btn btn-outline-secondary" href="/cooks/@CurrentUser.CurrentUser.Id">
                <Icon Name="magnifying-glass" Size="15" /> See them as a buyer
            </a>
        </div>
    </div>

    @if (_reviews.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><Icon Name="star" Size="26" /></div>
            <h3>No reviews yet</h3>
            <p>Buyers can only review a meal they actually collected, so reviews arrive after your first handover.</p>
            <a class="btn btn-primary mt-2" href="/post">Post a food drop</a>
        </div>
    }
    else
    {
        <div class="stat-grid mb-4">
            <StatTile Label="Rating" Value="@(profile.RatingAverage?.ToString("0.0") ?? "—")" IconName="star"
                      Hint="@($"across {_reviews.Count} reviews")" />
            <StatTile Label="Unanswered" Value="@unanswered.ToString()" IconName="chat"
                      Hint="@(unanswered == 0 ? "All replied to" : "A reply shows you're listening")" />
            <StatTile Label="Needs a reply" Value="@needsAttention.ToString()" IconName="warning" Muted="@(needsAttention == 0)"
                      Hint="3.5 stars or below" />
            <StatTile Label="Regulars" Value="@profile.RepeatCustomers.ToString()" IconName="users" Muted="true"
                      Hint="Buyers who came back" />
        </div>

        <div class="segmented mb-4" role="tablist">
            <button role="tab" class="@(_filter == Filter.All ? "active" : "")" @onclick="() => _filter = Filter.All">
                All<span class="seg-count">@_reviews.Count</span>
            </button>
            <button role="tab" class="@(_filter == Filter.Unanswered ? "active" : "")" @onclick="() => _filter = Filter.Unanswered">
                Unanswered<span class="seg-count">@unanswered</span>
            </button>
            <button role="tab" class="@(_filter == Filter.Attention ? "active" : "")" @onclick="() => _filter = Filter.Attention">
                Needs a reply<span class="seg-count">@needsAttention</span>
            </button>
        </div>

        var shown = _filter switch
        {
            Filter.Unanswered => _reviews.Where(r => !r.IsAnswered).ToList(),
            Filter.Attention => _reviews.Where(r => r.NeedsAttention).ToList(),
            _ => _reviews,
        };

        @if (shown.Count == 0)
        {
            <div class="callout callout-success">
                <Icon Name="check-circle" Size="18" />
                <div>Nothing here — you've replied to everything in this filter.</div>
            </div>
        }
        else
        {
            <div class="surface-card p-4">
                @foreach (var review in shown)
                {
                    <div class="review-card">
                        <div class="review-head">
                            <span style="font-size:1.3rem;">@review.BuyerAvatar</span>
                            <strong>@review.BuyerName</strong>
                            <StarRating Precise="review.Overall" Size="14" />
                            <span class="review-dish">
                                · @review.DropTitle · @review.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                            </span>
                            @if (review.NeedsAttention)
                            {
                                <span class="badge-pill badge-urgent ms-auto">Worth a reply</span>
                            }
                            else if (!review.IsAnswered)
                            {
                                <span class="badge-pill badge-info ms-auto">Unanswered</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="review-body">@review.Comment</p>
                        }
                        <div class="review-subscores">
                            <span>Food @review.FoodQuality/5</span>
                            <span>Value @review.Value/5</span>
                            <span>As described @review.Accuracy/5</span>
                            <span>Pickup @review.PickupExperience/5</span>
                            <a href="/orders/@review.OrderId">View order</a>
                        </div>

                        @if (review.IsAnswered && _replyingTo != review.ReviewId)
                        {
                            <div class="seller-reply">
                                <div class="seller-reply-head">
                                    <Icon Name="chef-hat" Size="14" />
                                    <strong>You replied</strong>
                                    <span class="review-dish">· @review.SellerRespondedAt?.ToLocalTime().ToString("d MMM yyyy")</span>
                                </div>
                                <p class="mb-0">@review.SellerResponse</p>
                            </div>
                        }
                        else if (_replyingTo == review.ReviewId)
                        {
                            <div class="mt-3">
                                <textarea class="form-control mb-2" rows="3" @bind="_replyDraft"
                                          placeholder="@ReplyPlaceholder(review)"></textarea>
                                <div class="d-flex gap-2 align-items-center">
                                    <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => SaveReply(review.ReviewId)">
                                        Post reply
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _replyingTo = null">Cancel</button>
                                    <span class="field-hint">Public, on your cook page.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary mt-3" @onclick="() => StartReply(review)">
                                <Icon Name="chat" Size="15" /> Reply
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }
}

<style>
    .seller-reply {
        margin-top: var(--space-3);
        padding: var(--space-3);
        background: var(--color-surface-alt);
        border-radius: var(--radius-md);
        border-left: 3px solid var(--color-accent);
        font-size: var(--fs-sm);
    }
    .seller-reply-head { display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--space-1); }
    .seller-reply-head svg { color: var(--color-accent); }
</style>

@code {
    private enum Filter { All, Unanswered, Attention }

    private List<CookReview>? _reviews;
    private Filter _filter = Filter.All;
    private int? _replyingTo;
    private string _replyDraft = "";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += OnUserChanged;
        await Load();
    }

    private async Task Load()
    {
        if (CurrentUser.CurrentUser is null || !CurrentUser.IsSeller) { _reviews = null; return; }
        _reviews = await Sellers.GetReviewsAsync(CurrentUser.CurrentUser.Id);
    }

    private void StartReply(CookReview review)
    {
        _replyingTo = review.ReviewId;
        _replyDraft = review.SellerResponse ?? "";
    }

    private static string ReplyPlaceholder(CookReview review) => review.NeedsAttention
        ? "What went wrong, and what you'll do differently. A straight answer reads better than an apology."
        : "Thank them, or answer anything they raised.";

    private async Task SaveReply(int reviewId)
    {
        if (CurrentUser.CurrentUser is null || string.IsNullOrWhiteSpace(_replyDraft)) return;
        _busy = true;
        await Sellers.RespondToReviewAsync(reviewId, CurrentUser.CurrentUser.Id, _replyDraft);
        _replyingTo = null;
        _replyDraft = "";
        await Load();
        await CurrentUser.RefreshAsync(); // refreshes the nav's unanswered count
        _busy = false;
    }

    private async void OnUserChanged()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => CurrentUser.OnChange -= OnUserChanged;
}
