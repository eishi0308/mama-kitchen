@page "/orders/{Id:int}"
@inject IOrderService OrderService
@inject IFoodDropService FoodDropService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Order — Batch</PageTitle>

@if (CurrentUser.CurrentUser is null)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="user" Size="26" /></div>
        <h3>Pick who you are first</h3>
        <p>Choose a demo user in the sidebar to see this order.</p>
    </div>
}
else if (_loaded && _order is null)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="magnifying-glass" Size="26" /></div>
        <h3>Order not found</h3>
        <p>Either it doesn't exist, or it's not one of yours.</p>
        <a class="btn btn-outline-secondary" href="/orders">Your orders</a>
    </div>
}
else if (_order is null)
{
    <div class="skeleton" style="height:420px; max-width:600px;"></div>
}
else
{
    var order = _order;
    var drop = order.FoodDrop!;
    var isSeller = drop.SellerId == CurrentUser.CurrentUser.Id;
    var live = order.Status is OrderStatus.Confirmed or OrderStatus.Preparing or OrderStatus.Ready;

    <a class="back-link" href="@(isSeller ? $"/kitchen/drops/{drop.Id}" : "/orders")">
        <Icon Name="arrow-left" Size="15" /> @(isSeller ? "Back to this batch" : "Your orders")
    </a>

    <div style="max-width:600px;">
        <div class="surface-card p-4 fade-in mb-4">
            @if (!isSeller)
            {
                @* ---------------- BUYER ---------------- *@
                <h1 style="font-size:var(--fs-xl); margin-bottom:0.15em;">@BuyerHeadline(order.Status)</h1>
                <p class="text-muted mb-4">@BuyerSubline(order, drop)</p>

                <OrderStatusTrack Status="order.Status" />
            }
            else
            {
                @* ---------------- SELLER ---------------- *@
                <h1 style="font-size:var(--fs-xl); margin-bottom:0.15em;">@order.Buyer?.Avatar @order.Buyer?.Name</h1>
                <p class="text-muted mb-4">
                    @drop.Title × @order.Quantity ·
                    <span class="money">$@order.TotalAmount.ToString("0.00")</span> ·
                    ordered @order.CreatedAt.ToLocalTime().ToString("d MMM, h:mm tt")
                </p>
                <OrderStatusTrack Status="order.Status" />
            }

            <div class="divider"></div>

            <div class="d-flex align-items-center gap-3 mb-4">
                <span style="font-size:2.4rem;">@drop.ImageEmoji</span>
                <div class="flex-grow-1">
                    <a href="/food/@drop.Id" class="fw-bold text-decoration-none" style="color:inherit;">@drop.Title</a>
                    <div class="text-muted small">
                        @order.Quantity × $@order.UnitPriceSnapshot.ToString("0.##")
                        @if (!isSeller)
                        {
                            <text> · by <a href="/cooks/@drop.SellerId">@drop.Seller?.Name</a></text>
                        }
                    </div>
                </div>
                <div class="fw-bold money">$@order.TotalAmount.ToString("0.00")</div>
            </div>

            <div class="mb-3">
                <div class="text-muted small mb-1" style="letter-spacing:0.04em;">PICKUP</div>
                <div class="fw-bold">
                    @drop.PickupWindowStart.ToLocalTime().ToString("ddd d MMM, h:mm tt")–@drop.PickupWindowEnd.ToLocalTime().ToString("h:mm tt")
                </div>

                @if (RevealAddress(order.Status))
                {
                    @* The two-tier address model: exact location only ever
                       appears once an order is actually paid for. *@
                    <div class="mt-1">@drop.PickupLocation?.ExactAddress</div>
                    @if (!string.IsNullOrWhiteSpace(drop.PickupLocation?.Instructions))
                    {
                        <div class="text-muted small fst-italic mt-1">@drop.PickupLocation!.Instructions</div>
                    }
                }
                else
                {
                    <div class="text-muted small mt-1">
                        @drop.PickupLocation?.Suburb — exact address was hidden after this order ended.
                    </div>
                }
            </div>

            @if (!isSeller && live)
            {
                <div class="text-center my-4 py-3" style="background:var(--color-surface-alt); border-radius:var(--radius-lg);">
                    <div class="text-muted small mb-2" style="letter-spacing:0.06em;">SHOW THIS CODE AT PICKUP</div>
                    <div class="pickup-code">@order.PickupCode</div>
                    <p class="text-muted small mt-3 mb-0 px-4">
                        @drop.Seller?.Name types this in to confirm you collected. Don't share it before you're there.
                    </p>
                </div>
            }

            @if (isSeller && live)
            {
                <div class="callout callout-info d-block mb-3">
                    <div class="text-muted small mb-2" style="letter-spacing:0.04em;">ENTER @(order.Buyer?.Name.ToUpper())'S PICKUP CODE</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <input class="form-control code-input" maxlength="4" inputmode="numeric" placeholder="0000"
                               aria-label="Pickup code" @bind="_codeInput" @bind:event="oninput" />
                        <button class="btn btn-primary" disabled="@_busy" @onclick="ConfirmPickup">Confirm pickup</button>
                    </div>
                    @if (_pickupError is not null)
                    {
                        <p class="text-danger small mt-2 mb-0">@_pickupError</p>
                    }
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    @if (order.Status == OrderStatus.Confirmed)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => Advance(OrderStatus.Preparing)">
                            <Icon Name="flame" Size="15" /> Mark cooking
                        </button>
                    }
                    @if (order.Status is OrderStatus.Confirmed or OrderStatus.Preparing)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => Advance(OrderStatus.Ready)">
                            <Icon Name="check-circle" Size="15" /> Mark ready
                        </button>
                    }
                    <a class="btn btn-sm btn-outline-secondary" href="/messages/@drop.Id/@order.BuyerId">
                        <Icon Name="chat" Size="15" /> Message @order.Buyer?.Name
                    </a>
                </div>
            }

            @* ---------------- Buyer: cancel ---------------- *@
            @if (!isSeller && live)
            {
                var canCancel = DateTime.UtcNow < drop.OrderDeadline;
                <div class="divider"></div>

                @if (canCancel)
                {
                    @if (!_showCancel)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                            <p class="text-muted small mb-0" style="flex:1 1 240px;">
                                Free cancellation until @drop.OrderDeadline.ToLocalTime().ToString("h:mm tt") —
                                after that @drop.Seller?.Name has shopped and started cooking.
                            </p>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _showCancel = true">Cancel order</button>
                        </div>
                    }
                    else
                    {
                        <div class="callout callout-danger d-block">
                            <div class="d-flex gap-3 mb-3">
                                <Icon Name="warning" Size="18" />
                                <div>
                                    Cancel this order and we'll refund
                                    <strong class="money">$@order.TotalAmount.ToString("0.00")</strong> in full.
                                    Your @(order.Quantity == 1 ? "portion goes" : "portions go") back up for someone else.
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="CancelOrder">
                                    Yes, cancel and refund
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showCancel = false">Keep my order</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="callout callout-info">
                        <Icon Name="info" Size="18" />
                        <div>
                            Orders closed at @drop.OrderDeadline.ToLocalTime().ToString("h:mm tt"), so this one can't be
                            cancelled for a refund any more — @drop.Seller?.Name is cooking it.
                            <a href="/messages/@drop.Id/@drop.SellerId">Message them</a> if something's come up.
                        </div>
                    </div>
                }

                @if (_actionError is not null)
                {
                    <p class="text-danger small mt-2 mb-0">@_actionError</p>
                }
            }

            @if (!isSeller && order.Status is OrderStatus.Refunded or OrderStatus.SellerCancelled)
            {
                <div class="divider"></div>
                <div class="callout callout-info">
                    <Icon Name="wallet" Size="18" />
                    <div>
                        <strong class="money">$@order.TotalAmount.ToString("0.00")</strong> was refunded to your
                        original payment method.
                        @if (!string.IsNullOrWhiteSpace(order.CancellationReason))
                        {
                            <text> Reason: @order.CancellationReason.</text>
                        }
                    </div>
                </div>
            }
        </div>

        @* The one instruction that matters right now. Every state answers it. *@
        @if (!isSeller && BuyerNextStep(order, drop) is BuyerAction action)
        {
            <NextStep Title="@action.Title" Eyebrow="@action.Eyebrow" IconName="@action.Icon" Tone="@action.Tone">
                @action.Detail
            </NextStep>
        }

        @* ---------------- Buyer: review ---------------- *@
        @if (!isSeller && order.Status == OrderStatus.Collected)
        {
            <div class="surface-card p-4 mb-4">
                @if (order.Review is not null)
                {
                    <h2 class="form-section-title" style="font-size:var(--fs-base);">Your review</h2>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <StarRating Precise="@((order.Review.FoodQuality + order.Review.Value + order.Review.Accuracy + order.Review.PickupExperience) / 4m)" Size="16" />
                        <span class="text-muted small">@order.Review.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(order.Review.Comment))
                    {
                        <p class="mb-2">@order.Review.Comment</p>
                    }
                    <p class="field-hint mb-0">
                        This counts towards @drop.Seller?.Name's rating on
                        <a href="/cooks/@drop.SellerId">their cook page</a>.
                    </p>
                }
                else if (_reviewSubmitted)
                {
                    <div class="callout callout-success">
                        <Icon Name="check-circle" Size="18" />
                        <div><strong>Thanks — that's live.</strong> @drop.Seller?.Name's rating has been updated.</div>
                    </div>
                }
                else
                {
                    <h2 class="form-section-title" style="font-size:var(--fs-base);">How was it?</h2>
                    <p class="form-section-hint">
                        Four quick ratings. This is how the next person decides whether to trust @drop.Seller?.Name's kitchen.
                    </p>

                    @foreach (var dimension in Dimensions())
                    {
                        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom:1px solid var(--color-border);">
                            <div>
                                <div class="fw-bold" style="font-size:var(--fs-sm);">@dimension.Label</div>
                                <div class="field-hint">@dimension.Hint</div>
                            </div>
                            <StarRating Value="dimension.Get()" ValueChanged="dimension.Set" Interactive="true" Size="22" Label="@dimension.Label" />
                        </div>
                    }

                    <div class="my-3">
                        <label class="form-label">Anything you'd tell a neighbour? <span class="text-muted">(optional)</span></label>
                        <textarea class="form-control" rows="3" @bind="_comment"
                                  placeholder="What was good, what wasn't, how the pickup went."></textarea>
                    </div>

                    @if (_reviewError is not null)
                    {
                        <p class="text-danger small">@_reviewError</p>
                    }

                    <button class="btn btn-primary" disabled="@(_busy || !ReviewComplete())" @onclick="SubmitReview">
                        @if (ReviewComplete())
                        {
                            <text>Post review</text>
                        }
                        else
                        {
                            <text>Rate all four to post</text>
                        }
                    </button>
                }
            </div>
        }

        @* ---------------- Buyer: receipt + reorder ---------------- *@
        @if (!isSeller)
        {
            <div class="surface-card p-4">
                <h2 class="form-section-title" style="font-size:var(--fs-base);">Receipt</h2>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">@order.Quantity × @drop.Title</span>
                    <span class="money">$@order.TotalAmount.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Delivery</span>
                    <span>Pickup — no fee</span>
                </div>
                <div class="d-flex justify-content-between py-1" style="font-weight:700; border-top:1px solid var(--color-border); margin-top:var(--space-2); padding-top:var(--space-2);">
                    <span>@(order.Status is OrderStatus.Refunded or OrderStatus.SellerCancelled ? "Refunded" : "Total paid")</span>
                    <span class="money">$@order.TotalAmount.ToString("0.00")</span>
                </div>
                @if (order.Payment is not null)
                {
                    <p class="field-hint mt-2 mb-0">
                        @order.Payment.Provider · @order.Payment.Reference · @order.Payment.Status
                    </p>
                }

                <div class="d-flex gap-2 flex-wrap mt-4">
                    <a class="btn btn-outline-secondary btn-sm" href="/messages/@drop.Id/@drop.SellerId">
                        <Icon Name="chat" Size="15" /> Message @drop.Seller?.Name
                    </a>
                    <a class="btn btn-outline-secondary btn-sm" href="/cooks/@drop.SellerId">
                        <Icon Name="user" Size="15" /> @drop.Seller?.Name's other food
                    </a>
                    @if (order.Status is OrderStatus.Collected or OrderStatus.Refunded or OrderStatus.SellerCancelled or OrderStatus.BuyerNoShow)
                    {
                        @if (_reorderTarget is FoodDrop again)
                        {
                            <a class="btn btn-primary btn-sm" href="/food/@again.Id">
                                <Icon Name="arrow-right" Size="15" /> Order again — @again.Title
                            </a>
                        }
                    }
                </div>

                <PerspectiveSwitch TargetUserId="drop.SellerId"
                                   TargetName="@(drop.Seller?.Name ?? "the cook")"
                                   TargetAvatar="@(drop.Seller?.Avatar ?? "🧑‍🍳")"
                                   TargetUrl="@($"/kitchen/drops/{drop.Id}")"
                                   Explanation="@($"This same order sits in {drop.Seller?.Name}'s handover queue right now. Jump over to type in your pickup code and watch this page update.")" />
            </div>
        }
        else
        {
            <div class="surface-card p-4">
                <PerspectiveSwitch TargetUserId="order.BuyerId"
                                   TargetName="@(order.Buyer?.Name ?? "the buyer")"
                                   TargetAvatar="@(order.Buyer?.Avatar ?? "🙂")"
                                   TargetUrl="@($"/orders/{order.Id}")"
                                   Explanation="@($"See what {order.Buyer?.Name} sees: their pickup code, your address, and the tracker that moves when you mark this batch cooking or ready.")" />
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Order? _order;
    private FoodDrop? _reorderTarget;
    private bool _loaded;
    private bool _busy;

    private string _codeInput = "";
    private string? _pickupError;
    private string? _actionError;
    private bool _showCancel;

    private int _foodQuality, _value, _accuracy, _pickupExperience;
    private string _comment = "";
    private string? _reviewError;
    private bool _reviewSubmitted;

    private PeriodicTimer? _timer;

    private record Dimension(string Label, string Hint, Func<int> Get, Action<int> Set);

    private IEnumerable<Dimension> Dimensions()
    {
        yield return new("Food", "Taste, portion, temperature", () => _foodQuality, v => _foodQuality = v);
        yield return new("Value", "Worth what you paid?", () => _value, v => _value = v);
        yield return new("As described", "Did it match the listing?", () => _accuracy, v => _accuracy = v);
        yield return new("Pickup", "Easy to find, ready on time?", () => _pickupExperience, v => _pickupExperience = v);
    }

    private bool ReviewComplete() => _foodQuality > 0 && _value > 0 && _accuracy > 0 && _pickupExperience > 0;

    protected override async Task OnInitializedAsync()
    {
        // Must subscribe, not just read CurrentUser.CurrentUser once: on a
        // fresh reload, Blazor Server's prerender pass runs before the
        // signed-in user resolves from localStorage (see
        // CurrentUserService.InitializeAsync). Every other page re-renders
        // once NavMenu resolves it via this event; without the subscription
        // here, a refreshed order page could get permanently stuck showing
        // "pick a user" even though the sidebar correctly shows you're signed in.
        CurrentUser.OnChange += OnUserChanged;
        await Load();

        // Light polling so a seller marking the order Ready/Collected on their
        // own screen is reflected here without the buyer refreshing manually.
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = PollAsync();
    }

    protected override async Task OnParametersSetAsync() => await Load();

    private async void OnUserChanged()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PollAsync()
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync())
            {
                // Don't refresh out from under an open dialog or a half-written review.
                if (_busy || _showCancel || _foodQuality > 0) continue;
                await Load();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
    }

    private async Task Load()
    {
        if (CurrentUser.CurrentUser is null) { _loaded = true; return; }
        _order = await OrderService.GetByIdAsync(Id, CurrentUser.CurrentUser.Id);
        _loaded = true;

        // "Order again" needs a drop that's actually orderable now — offering a
        // finished batch would be a link to a dead end.
        if (_order?.FoodDrop is not null && _order.BuyerId == CurrentUser.CurrentUser.Id)
        {
            var more = await FoodDropService.GetMoreFromCookAsync(_order.FoodDrop.SellerId, excludeDropId: -1, take: 6);
            _reorderTarget = more.FirstOrDefault(d => d.IsOrderable && d.Title == _order.FoodDrop.Title)
                             ?? more.FirstOrDefault(d => d.IsOrderable);
        }
    }

    private record BuyerAction(string Title, string Eyebrow, string Icon, string? Tone, string Detail);

    /// The single instruction for the buyer's current state. Returning null
    /// means there is genuinely nothing for them to do.
    private static BuyerAction? BuyerNextStep(Order o, FoodDrop drop)
    {
        var window = $"{drop.PickupWindowStart.ToLocalTime():h:mm tt}–{drop.PickupWindowEnd.ToLocalTime():h:mm tt}";
        var place = drop.PickupLocation?.ExactAddress ?? drop.PickupLocation?.Suburb ?? "";

        return o.Status switch
        {
            OrderStatus.Confirmed => new BuyerAction(
                $"Collect between {window}",
                "Next step", "clock", null,
                $"Head to {place} inside that window and read out code {o.PickupCode}. {drop.Seller?.Name} will start cooking closer to the time — this page updates when they do."),

            OrderStatus.Preparing => new BuyerAction(
                $"{drop.Seller?.Name} is cooking now",
                "Happening now", "flame", null,
                $"Nothing to do yet. Be at {place} between {window} with code {o.PickupCode}."),

            OrderStatus.Ready => new BuyerAction(
                "Your food is ready — go and get it",
                "Do this now", "check-circle", "success",
                $"{place}. Read out code {o.PickupCode} when you arrive and {drop.Seller?.Name} will close the order."),

            OrderStatus.Collected when o.Review is null => new BuyerAction(
                "Rate your meal",
                "Last step", "star", null,
                $"Four quick ratings below. It's the only thing that sets {drop.Seller?.Name}'s public rating, and it's how the next person decides whether to trust their kitchen."),

            OrderStatus.Collected => new BuyerAction(
                "All done — nothing left to do",
                "Finished", "check-circle", "success",
                "You collected this meal and rated it. Order it again any time from the cook's page."),

            OrderStatus.Ready or OrderStatus.PendingPayment => null,

            OrderStatus.SellerCancelled or OrderStatus.Refunded => new BuyerAction(
                "You've been refunded in full",
                "Nothing owed", "wallet", "warn",
                "Nothing further is needed from you. Your money went back to the card you paid with."),

            OrderStatus.BuyerNoShow => new BuyerAction(
                "This one wasn't collected",
                "Finished", "warning", "warn",
                "The pickup window closed before you arrived, so this order wasn't refunded — the food had already been made."),

            _ => null,
        };
    }

    private static bool RevealAddress(OrderStatus status) =>
        status is OrderStatus.Confirmed or OrderStatus.Preparing or OrderStatus.Ready or OrderStatus.Collected;

    private static string BuyerHeadline(OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "Payment not finished",
        OrderStatus.Confirmed => "Reserved",
        OrderStatus.Preparing => "Your cook has started",
        OrderStatus.Ready => "Ready to collect",
        OrderStatus.Collected => "Collected",
        OrderStatus.Refunded => "Cancelled and refunded",
        OrderStatus.SellerCancelled => "Cancelled by the cook",
        OrderStatus.BuyerNoShow => "Not collected",
        _ => status.ToString(),
    };

    private static string BuyerSubline(Order order, FoodDrop drop) => order.Status switch
    {
        OrderStatus.PendingPayment => "This order was never paid for, so no portion is being held.",
        OrderStatus.Confirmed =>
            $"{drop.Seller?.Name} has your order. Collect it between {drop.PickupWindowStart.ToLocalTime():h:mm tt} and {drop.PickupWindowEnd.ToLocalTime():h:mm tt}.",
        OrderStatus.Preparing => $"{drop.Seller?.Name} is cooking your food right now.",
        OrderStatus.Ready => "It's ready — head over any time in your pickup window.",
        OrderStatus.Collected => "Enjoy your meal. Rating it below helps the next person choose.",
        OrderStatus.Refunded => "You were refunded in full.",
        OrderStatus.SellerCancelled => "The cook couldn't go ahead. You were refunded in full.",
        OrderStatus.BuyerNoShow => "This order wasn't collected before the pickup window closed.",
        _ => "",
    };

    private async Task ConfirmPickup()
    {
        if (CurrentUser.CurrentUser is null) return;
        _busy = true;
        _pickupError = null;
        var result = await OrderService.ConfirmPickupAsync(Id, CurrentUser.CurrentUser.Id, _codeInput.Trim());
        if (!result.Success)
        {
            _pickupError = result.Error switch
            {
                PickupConfirmError.CodeMismatch => "That code doesn't match — ask the buyer to double check.",
                PickupConfirmError.NotConfirmed => "This order isn't ready for pickup yet.",
                _ => "Couldn't confirm this pickup.",
            };
        }
        await Load();
        _busy = false;
    }

    private async Task Advance(OrderStatus target)
    {
        if (CurrentUser.CurrentUser is null) return;
        _busy = true;
        await OrderService.AdvanceStatusAsync(Id, CurrentUser.CurrentUser.Id, target);
        await Load();
        _busy = false;
    }

    private async Task CancelOrder()
    {
        if (CurrentUser.CurrentUser is null) return;
        _busy = true;
        _actionError = null;
        var result = await OrderService.CancelByBuyerAsync(Id, CurrentUser.CurrentUser.Id);
        if (!result.Success)
        {
            _actionError = result.Error switch
            {
                OrderActionError.TooLateToCancel => "Orders just closed for this drop, so it can't be cancelled for a refund any more.",
                OrderActionError.WrongStatus => "This order can't be cancelled any more.",
                OrderActionError.RefundFailed => "The refund didn't go through — nothing was changed. Please try again.",
                _ => "Couldn't cancel this order.",
            };
        }
        _showCancel = false;
        await Load();
        _busy = false;
    }

    private async Task SubmitReview()
    {
        if (CurrentUser.CurrentUser is null || !ReviewComplete()) return;
        _busy = true;
        _reviewError = null;

        var result = await OrderService.LeaveReviewAsync(
            Id, CurrentUser.CurrentUser.Id, _foodQuality, _value, _accuracy, _pickupExperience, _comment);

        if (!result.Success)
        {
            _reviewError = result.Error switch
            {
                OrderActionError.AlreadyReviewed => "You've already reviewed this order.",
                OrderActionError.NotCollected => "You can only review an order you collected.",
                OrderActionError.InvalidRating => "Every rating has to be between 1 and 5.",
                _ => "Couldn't post your review.",
            };
        }
        else
        {
            _reviewSubmitted = true;
            _foodQuality = _value = _accuracy = _pickupExperience = 0;
            _comment = "";
        }

        await Load();
        _busy = false;
    }

    public async ValueTask DisposeAsync()
    {
        CurrentUser.OnChange -= OnUserChanged;
        _timer?.Dispose();
        _timer = null;
        await ValueTask.CompletedTask;
    }
}
