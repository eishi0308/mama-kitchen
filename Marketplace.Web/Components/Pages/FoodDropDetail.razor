@page "/food/{Id:int}"
@inject IFoodDropService FoodDropService
@inject IFavoriteService FavoriteService
@inject IMessageService MessageService
@inject IOrderService OrderService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(_drop?.Title ?? "Food drop") — Batch</PageTitle>

@if (_drop is null)
{
    <div class="row g-4">
        <div class="col-md-6"><div class="skeleton" style="height:320px;"></div></div>
        <div class="col-md-6"><div class="skeleton" style="height:320px;"></div></div>
    </div>
}
else
{
    var closed = !_drop.IsOrderable;
    var soldOut = _drop.PortionsRemaining == 0;
    // A batch whose pickup window has passed is FINISHED, not "sold out".
    // "Sold out" reads as "you just missed out, try again" and sent people
    // looking for a Reserve button that will never come back.
    var finished = _drop.Status is FoodDropStatus.Completed
                   || _drop.PickupWindowEnd < DateTime.UtcNow
                   || _drop.Status == FoodDropStatus.Cancelled;
    var cancelled = _drop.Status == FoodDropStatus.Cancelled;

    <div class="row g-4 fade-in">
        <div class="col-md-6">
            <div class="food-hero surface-card">
                @if (!string.IsNullOrWhiteSpace(_drop.ImageUrl))
                {
                    <img src="@_drop.ImageUrl" alt="@_drop.Title" />
                }
                else
                {
                    <span style="font-size:7rem;">@_drop.ImageEmoji</span>
                }
            </div>

            <div class="surface-card p-3 mt-3">
                <h5 style="font-size:var(--fs-base); font-weight:600;">Pickup details</h5>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">@(_drop.OrderDeadline < DateTime.UtcNow ? "Orders closed" : "Orders close")</span>
                    <strong>@_drop.OrderDeadline.ToLocalTime().ToString("ddd d MMM, h:mm tt")</strong>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Pickup window</span>
                    <strong>@_drop.PickupWindowStart.ToLocalTime().ToString("h:mm tt")–@_drop.PickupWindowEnd.ToLocalTime().ToString("h:mm tt")</strong>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Location</span>
                    <strong>@_drop.PickupLocation?.Suburb · @DistanceLabel()</strong>
                </div>
                @if (finished)
                {
                    <p class="text-muted small mt-2 mb-0">
                        This batch finished @Ago(_drop.PickupWindowEnd). It's kept here so the cook's history and
                        reviews still make sense.
                    </p>
                }
                else
                {
                    <p class="text-muted small mt-2 mb-0">Exact pickup address and instructions are revealed once your order is confirmed and paid.</p>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="d-flex gap-2 mb-2 flex-wrap">
                @if (cancelled)
                {
                    <span class="badge-pill badge-sold-out">Cancelled</span>
                }
                else if (_drop.Status == FoodDropStatus.Completed)
                {
                    <span class="badge-pill badge-sold-out">Batch finished</span>
                }
                else if (finished)
                {
                    <span class="badge-pill badge-sold-out">Pickup window closed</span>
                }
                else if (soldOut)
                {
                    <span class="badge-pill badge-sold-out">Sold out</span>
                }
                else if (closed)
                {
                    <span class="badge-pill badge-sold-out">Orders closed</span>
                }
                else if (_drop.PortionsRemaining <= 3)
                {
                    <span class="badge-pill badge-urgent">Only @_drop.PortionsRemaining left</span>
                }
                <span class="badge-pill badge-info">@_drop.Category?.Icon @_drop.Category?.Name</span>
            </div>

            <h1 style="font-size:var(--fs-2xl);">@_drop.Title</h1>
            <div class="meal-card-price" style="font-size:var(--fs-xl);">$@_drop.Price.ToString("0.##") <span class="text-muted" style="font-size:var(--fs-sm); font-weight:400;">per portion</span></div>
            <p class="text-muted mt-1">@_drop.PortionsRemaining of @_drop.PortionsTotal portions left</p>

            <p style="white-space:pre-wrap;" class="mt-3">@_drop.Description</p>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var label in DietaryLabels())
                {
                    <span class="badge-pill badge-verified">@label</span>
                }
            </div>

            <div class="surface-card p-3 mb-3">
                <div class="row g-2 small">
                    <div class="col-12"><strong>Ingredients:</strong> <span class="text-muted">@_drop.Ingredients</span></div>
                    <div class="col-12"><strong>Allergens:</strong> <span class="text-muted">@(_drop.Allergens is { Length: > 0 } a ? a : "None declared")</span></div>
                </div>
            </div>

            @* The cook, not just their name. Trust is the whole decision in a
               hyperlocal food marketplace, so this is a route into their page
               rather than a dead label. *@
            <a class="surface-card p-3 mb-3 seller-card d-block text-decoration-none" style="color:inherit;"
               href="/cooks/@_drop.SellerId">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size:1.8rem;">@_drop.Seller?.Avatar</span>
                    <div class="flex-grow-1">
                        <div class="fw-bold d-inline-flex align-items-center gap-1">
                            @_drop.Seller?.Name
                            @if (_drop.Seller?.SellerProfile?.VerificationStatus == VerificationStatus.Verified)
                            {
                                <Icon Name="check-circle" Size="15" Class="verified-icon" />
                            }
                        </div>
                        <div class="text-muted small">@_drop.Seller?.SellerProfile?.Cuisine · @_drop.Seller?.SellerProfile?.Suburb</div>
                    </div>
                    <div class="text-end">
                        @if (_drop.Seller?.SellerProfile?.RatingAverage is decimal r)
                        {
                            <div class="fw-bold d-inline-flex align-items-center gap-1"><Icon Name="star" Size="14" Filled="true" Class="star-icon" /> @r.ToString("0.0")</div>
                            <div class="text-muted small">@_drop.Seller.SellerProfile.CompletedOrders orders</div>
                        }
                        else
                        {
                            <div class="badge-pill badge-info">New cook</div>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_drop.Seller?.SellerProfile?.Story))
                {
                    <p class="text-muted small mt-2 mb-2 fst-italic">"@_drop.Seller!.SellerProfile!.Story"</p>
                }
                <div class="small fw-bold d-flex align-items-center gap-1" style="color:var(--color-primary);">
                    See @_drop.Seller?.Name's kitchen and reviews <Icon Name="arrow-right" Size="14" />
                </div>
            </a>

            @if (CurrentUser.CurrentUser is null)
            {
                @* This page is public — you can read the whole listing signed out.
                   Only the actions need an account, so this is an invitation
                   rather than a wall. *@
                <a class="btn btn-primary w-100" href="/login?returnUrl=@Uri.EscapeDataString($"/food/{_drop.Id}")">
                    Sign in to reserve
                </a>
                <p class="text-muted small mt-2 mb-0">
                    <em>Google, or a one-click demo account.</em>
                </p>
            }
            else if (_drop.SellerId == CurrentUser.CurrentUser.Id)
            {
                <div class="surface-card p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <Icon Name="chef-hat" Size="16" Class="text-muted" />
                        <strong style="font-size:var(--fs-sm);">Your batch — this is the buyer's view of it</strong>
                    </div>

                    @if (_board is null)
                    {
                        <div class="skeleton" style="height:44px;"></div>
                    }
                    else if (_board.AwaitingPickup > 0)
                    {
                        @* The answer to "where do I confirm an order?" — say it
                           here, on the page they're actually looking at. *@
                        <p class="text-muted small mb-3">
                            @if (_drop.PickupWindowEnd < DateTime.UtcNow)
                            {
                                <text>
                                    <strong>@_board.AwaitingPickup @(_board.AwaitingPickup == 1 ? "person" : "people")</strong>
                                    didn't collect before the window closed. You can still confirm their code if they turn up
                                    late, or mark them as a no-show — either way it's on the manage screen.
                                </text>
                            }
                            else
                            {
                                <text>
                                    <strong>@_board.AwaitingPickup @(_board.AwaitingPickup == 1 ? "person is" : "people are")</strong>
                                    waiting to collect. You confirm each one by typing their 4-digit pickup code into their row —
                                    that's on the manage screen.
                                </text>
                            }
                        </p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-primary" href="/kitchen/drops/@_drop.Id">
                                <Icon Name="ticket" Size="15" /> @(_drop.PickupWindowEnd < DateTime.UtcNow ? "Resolve" : "Confirm pickups") (@_board.AwaitingPickup)
                            </a>
                            @if (_drop.Status is not (FoodDropStatus.Cancelled or FoodDropStatus.Completed))
                            {
                                <a class="btn btn-outline-secondary" href="/kitchen/drops/@_drop.Id/edit"><Icon Name="pencil" Size="15" /> Edit</a>
                            }
                        </div>
                    }
                    else if (finished)
                    {
                        <p class="text-muted small mb-3">
                            This batch is done — @_board.CollectedOrders collected,
                            <span class="money">$@NetOf(_board.GrossRevenue).ToString("0.00")</span> earned after fees.
                            Nothing left to confirm.
                        </p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-primary" href="/post?from=@_drop.Id"><Icon Name="package" Size="15" /> Cook this again</a>
                            <a class="btn btn-outline-secondary" href="/kitchen/drops/@_drop.Id"><Icon Name="list" Size="15" /> See the orders</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">
                            @(_board.PortionsSold == 0
                                ? "No orders yet. When someone reserves, you'll confirm their pickup with a 4-digit code on the manage screen."
                                : $"{_board.PortionsSold} portions reserved. When people arrive you'll confirm each pickup with their 4-digit code on the manage screen.")
                        </p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-primary" href="/kitchen/drops/@_drop.Id"><Icon Name="list" Size="15" /> Manage this batch</a>
                            <a class="btn btn-outline-secondary" href="/kitchen/drops/@_drop.Id/edit"><Icon Name="pencil" Size="15" /> Edit</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="text-muted">Portions</span>
                    <div class="qty-stepper">
                        <button type="button" @onclick="() => ChangeQty(-1)" disabled="@(closed || soldOut || _quantity <= 1)">−</button>
                        <span class="qty-value">@_quantity</span>
                        <button type="button" @onclick="() => ChangeQty(1)" disabled="@(closed || soldOut || _quantity >= _drop.PortionsRemaining)">+</button>
                    </div>
                </div>

                <div class="callout callout-info mb-3">
                    <Icon Name="info" Size="18" />
                    <div>
                        <strong>Pickup only.</strong> You'll get @_drop.Seller?.Name's exact address and a 4-digit code
                        once you've paid, then collect between
                        @_drop.PickupWindowStart.ToLocalTime().ToString("h:mm tt")–@_drop.PickupWindowEnd.ToLocalTime().ToString("h:mm tt").
                        Free cancellation until @_drop.OrderDeadline.ToLocalTime().ToString("h:mm tt") — after that they've shopped for your portion.
                    </div>
                </div>

                @if (finished)
                {
                    <div class="callout callout-info mb-3">
                        <Icon Name="clock" Size="18" />
                        <div>
                            <strong>@(_drop.Status == FoodDropStatus.Completed || cancelled ? "This batch has finished." : "Pickup for this batch has closed.")</strong>
                            @(cancelled
                                ? $" {_drop.Seller?.Name} cancelled it, and anyone who had ordered was refunded."
                                : $" It was collected {Ago(_drop.PickupWindowEnd)}.")
                            @if (_moreFromCook.Count > 0)
                            {
                                <text> @_drop.Seller?.Name has @_moreFromCook.Count more @(_moreFromCook.Count == 1 ? "batch" : "batches") coming up — see below.</text>
                            }
                            else
                            {
                                <text> Follow their kitchen to catch the next one.</text>
                            }
                        </div>
                    </div>
                }

                <div class="btn-sticky-cta d-flex gap-2">
                    <button class="btn btn-outline-warning d-flex align-items-center justify-content-center" style="min-width:44px;" @onclick="ToggleFavorite" title="Save">
                        <Icon Name="heart" Size="18" Filled="_isFavorite" />
                    </button>
                    <button class="btn btn-primary flex-grow-1" style="font-size:var(--fs-md);" disabled="@(closed || soldOut || finished)" @onclick="GoToCheckout">
                        @if (finished)
                        {
                            <text>This batch has finished</text>
                        }
                        else if (soldOut)
                        {
                            <text>Sold out</text>
                        }
                        else if (closed)
                        {
                            <text>Orders closed</text>
                        }
                        else
                        {
                            <text>Reserve @(_quantity > 1 ? $"{_quantity} · " : "")$@((_drop.Price * _quantity).ToString("0.##"))</text>
                        }
                    </button>
                </div>

                <details class="mt-3" open="@(_thread.Count > 0)">
                    <summary class="text-muted" style="cursor:pointer;">
                        Ask @_drop.Seller?.Name a question@(_thread.Count > 0 ? $" ({_thread.Count})" : "")
                    </summary>
                    <div class="surface-card p-3 mt-2 mb-2" style="max-height:260px; overflow-y:auto;">
                        @if (_thread.Count == 0)
                        {
                            <p class="text-muted small mb-0">
                                No messages yet. Allergies, portion size, timing — anything you'd want to know before reserving.
                            </p>
                        }
                        else
                        {
                            <div class="thread">
                                @foreach (var m in _thread)
                                {
                                    <div class="bubble @(m.SenderId == CurrentUser.CurrentUser.Id ? "bubble-mine" : "bubble-theirs")">
                                        @m.Body
                                        <span class="bubble-time">@m.SentAt.ToLocalTime().ToString("h:mm tt")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="input-group">
                        <input class="form-control" placeholder="Is this still available?" @bind="_draft" @onkeyup="HandleKeyUp" />
                        <button class="btn btn-outline-secondary" @onclick="SendMessage">Send</button>
                    </div>
                </details>
            }
        </div>
    </div>

    @* Cross-sell into the same cook rather than back out to the grid: someone
       reading this page has already decided they like this kitchen. *@
    @if (_moreFromCook.Count > 0)
    {
        <h2 class="section-heading">More from @_drop.Seller?.Name's kitchen</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
            @foreach (var other in _moreFromCook)
            {
                <div class="col">
                    <MealCard Drop="other" ShowFavoriteButton="false" OnOpen="GoToDrop" />
                </div>
            }
        </div>
        <a class="btn btn-outline-secondary" href="/cooks/@_drop.SellerId">
            See everything from @_drop.Seller?.Name <Icon Name="arrow-right" Size="15" />
        </a>
    }
}

<style>
    .food-hero {
        height: 320px;
        background: linear-gradient(135deg, var(--color-surface-alt), #EFE3D3);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .food-hero img { width: 100%; height: 100%; object-fit: cover; }
    .seller-card { transition: box-shadow var(--duration-standard) var(--ease-standard); }
    .seller-card:hover { box-shadow: var(--shadow-md); }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private FoodDrop? _drop;
    private bool _isFavorite;
    private int _quantity = 1;
    private List<Message> _thread = new();
    private List<FoodDrop> _moreFromCook = new();
    private DropOrderBoard? _board;
    private string _draft = "";

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += OnUserChanged;
        await Load();
    }

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        _drop = await FoodDropService.GetByIdAsync(Id);
        _quantity = 1;
        if (_drop is null) return;

        _moreFromCook = await FoodDropService.GetMoreFromCookAsync(_drop.SellerId, _drop.Id);

        // Only the owner needs the order board, and only they're allowed it.
        var isOwner = CurrentUser.CurrentUser is not null && CurrentUser.CurrentUser.Id == _drop.SellerId;
        _board = isOwner
            ? await OrderService.GetDropBoardAsync(_drop.Id, CurrentUser.CurrentUser!.Id)
            : null;

        // /food/{id} is a shared page, so the nav can't tell from the route
        // alone whose side you're on. Looking at your OWN listing is a cook
        // activity — otherwise you manage your batch with buyer nav beside it.
        if (isOwner && CurrentUser.Mode != AppMode.Cook)
        {
            await CurrentUser.SetModeAsync(AppMode.Cook);
        }

        if (CurrentUser.CurrentUser is not null && CurrentUser.CurrentUser.Id != _drop.SellerId)
        {
            _isFavorite = await FavoriteService.IsFavoriteAsync(CurrentUser.CurrentUser.Id, Id);
            _thread = await MessageService.GetThreadAsync(Id, CurrentUser.CurrentUser.Id, _drop.SellerId);
        }
    }

    private void ChangeQty(int delta)
    {
        if (_drop is null) return;
        var next = _quantity + delta;
        _quantity = Math.Clamp(next, 1, Math.Max(1, _drop.PortionsRemaining));
    }

    private static decimal NetOf(decimal gross) => Marketplace.Web.Services.SellerService.NetOf(gross);

    /// "3 weeks ago" — a finished batch needs to read as history, not as
    /// something you just missed by a minute.
    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} minutes ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hours ago";
        if (span.TotalDays < 14) return $"{(int)span.TotalDays} days ago";
        if (span.TotalDays < 60) return $"{(int)(span.TotalDays / 7)} weeks ago";
        return utc.ToLocalTime().ToString("d MMM yyyy");
    }

    private string DistanceLabel()
    {
        var km = _drop?.PickupLocation?.ApproxDistanceKm ?? 0;
        return km < 1 ? $"{km * 1000:0} m away" : $"{km:0.0} km away";
    }


    private IEnumerable<string> DietaryLabels()
    {
        if (_drop is null) yield break;
        foreach (DietaryLabel value in Enum.GetValues<DietaryLabel>())
        {
            if (value == DietaryLabel.None) continue;
            if (_drop.Dietary.HasFlag(value)) yield return value.ToString();
        }
    }

    private void GoToDrop(int id) => Nav.NavigateTo($"/food/{id}");

    private void GoToCheckout()
    {
        if (_drop is null) return;
        Nav.NavigateTo($"/checkout/{_drop.Id}?quantity={_quantity}");
    }

    private async void OnUserChanged()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleFavorite()
    {
        if (CurrentUser.CurrentUser is null || _drop is null) return;
        await FavoriteService.ToggleAsync(CurrentUser.CurrentUser.Id, _drop.Id);
        _isFavorite = !_isFavorite;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async Task SendMessage()
    {
        if (CurrentUser.CurrentUser is null || _drop is null || string.IsNullOrWhiteSpace(_draft)) return;
        await MessageService.SendAsync(_drop.Id, CurrentUser.CurrentUser.Id, _drop.SellerId, _draft);
        _draft = "";
        _thread = await MessageService.GetThreadAsync(_drop.Id, CurrentUser.CurrentUser.Id, _drop.SellerId);
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= OnUserChanged;
    }
}
