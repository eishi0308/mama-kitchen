@page "/favorites"
@attribute [Authorize]
@inject IFavoriteService FavoriteService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Saved — Batch</PageTitle>

<h1 class="page-title" style="font-size:var(--fs-xl); margin-bottom:var(--space-4);"><Icon Name="heart" Size="22" /> Saved</h1>

@if (_drops is null)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col"><div class="skeleton" style="height:168px;"></div></div>
        }
    </div>
}
else if (_drops.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="heart" Size="28" /></div>
        <h3>Nothing saved yet</h3>
        <p>Tap the heart on a food drop to keep track of it here.</p>
        <a class="btn btn-primary" href="/">Browse food nearby</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var d in _drops)
        {
            <div class="col">
                <MealCard Drop="d" IsFavorite="true" OnOpen="GoToDrop" OnToggleFavorite="ToggleFavorite" />
            </div>
        }
    </div>
}

@code {
    private List<FoodDrop>? _drops;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += OnUserChanged;
        await Load();
    }

    private async Task Load()
    {
        if (CurrentUser.CurrentUser is not null)
            _drops = await FavoriteService.GetFavoritesAsync(CurrentUser.CurrentUser.Id);
    }

    private async Task ToggleFavorite(int foodDropId)
    {
        if (CurrentUser.CurrentUser is null) return;
        await FavoriteService.ToggleAsync(CurrentUser.CurrentUser.Id, foodDropId);
        await Load();
    }

    private void GoToDrop(int id) => Nav.NavigateTo($"/food/{id}");

    private async void OnUserChanged()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= OnUserChanged;
    }
}
