@page "/checkout/{Id:int}"
@attribute [Authorize]
@inject IFoodDropService FoodDropService
@inject IOrderService OrderService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Checkout — Batch</PageTitle>

@if (_drop is null)
{
    <div class="skeleton" style="height:280px; max-width:520px;"></div>
}
else if (!_drop.IsOrderable)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="clock" Size="26" /></div>
        <h3>@(_drop.PortionsRemaining == 0 ? "This batch just sold out" : "Orders have closed for this batch")</h3>
        <p>Nothing has been charged. @_drop.Seller?.Name may cook it again — their other food drops are on their page.</p>
        <div class="d-flex gap-2 justify-content-center flex-wrap mt-2">
            <a class="btn btn-primary" href="/cooks/@_drop.SellerId">See @_drop.Seller?.Name's kitchen</a>
            <a class="btn btn-outline-secondary" href="/">Browse food nearby</a>
        </div>
    </div>
}
else
{
    <div class="surface-card p-4 fade-in" style="max-width:520px;">
        <a class="back-link" href="/food/@_drop.Id"><Icon Name="arrow-left" Size="15" /> Back to @_drop.Title</a>
        <h1 style="font-size:var(--fs-xl); margin-bottom:var(--space-4);">Your order</h1>

        <JourneySteps Steps="JourneySteps.Buyer" Current="1" Compact="true" Label="Your journey" />
        <div class="divider"></div>

        <div class="d-flex align-items-center gap-3 mb-3">
            <span style="font-size:2.2rem;">@_drop.ImageEmoji</span>
            <div class="flex-grow-1">
                <div class="fw-bold">@_drop.Title × @_quantity</div>
                <div class="text-muted small">@_drop.Seller?.Name · @_drop.Category?.Name</div>
            </div>
            <div class="fw-bold">$@((_drop.Price * _quantity).ToString("0.##"))</div>
        </div>

        <hr />

        <div class="mb-3">
            <div class="text-muted small mb-1">PICKUP</div>
            <div>@PickupDayLabel() · @_drop.PickupWindowStart.ToLocalTime().ToString("h:mm tt")–@_drop.PickupWindowEnd.ToLocalTime().ToString("h:mm tt")</div>
            <div class="text-muted">@_drop.PickupLocation?.Suburb</div>
        </div>

        <div class="mb-3">
            <div class="text-muted small mb-1">PAYMENT METHOD</div>
            <div class="d-flex gap-2">
                @foreach (var method in new[] { "Card", "Apple Pay", "Google Pay" })
                {
                    <button type="button" class="chip @(_paymentMethod == method ? "active" : "")" @onclick="() => _paymentMethod = method">@method</button>
                }
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted">Subtotal</span>
            <span>$@((_drop.Price * _quantity).ToString("0.00"))</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3" style="font-size:var(--fs-lg); font-weight:700;">
            <span>Total</span>
            <span>$@((_drop.Price * _quantity).ToString("0.00"))</span>
        </div>

        @if (_errorMessage is not null)
        {
            <div class="badge-pill badge-urgent d-block mb-3 p-2" style="white-space:normal;">@_errorMessage</div>
        }

        <button class="btn btn-primary w-100" style="font-size:var(--fs-md); padding:0.85rem;"
                disabled="@(_state != CheckoutState.Reviewing)" @onclick="Submit">
            @switch (_state)
            {
                case CheckoutState.Processing:
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <text>Confirming payment…</text>
                    break;
                case CheckoutState.Succeeded:
                    <Icon Name="check-circle" Size="18" Class="me-2" Filled="false" /><text>Reserved</text>
                    break;
                default:
                    <text>Reserve &amp; Pay</text>
                    break;
            }
        </button>

        <p class="text-muted small text-center mt-2 mb-0 d-flex align-items-center justify-content-center gap-1">
            <Icon Name="lock" Size="14" /> Payment protected — held securely until your order is fulfilled.
        </p>

        @* Set expectations before the money moves, not after. Everything here
           is a promise the app actually keeps: the code, the address reveal,
           and the free-cancellation window are all real behaviour. *@
        <div class="divider"></div>
        <div class="text-muted small mb-2" style="letter-spacing:0.04em;">WHAT HAPPENS NEXT</div>
        <ol class="text-muted small ps-3 mb-0" style="line-height:1.7;">
            <li>You get a 4-digit pickup code and @_drop.Seller?.Name's exact address.</li>
            <li>They cook, and your order updates as it goes — reserved, cooking, ready.</li>
            <li>You collect in the window above and read them your code.</li>
        </ol>
        <p class="text-muted small mt-3 mb-0">
            Free cancellation until @_drop.OrderDeadline.ToLocalTime().ToString("h:mm tt") — after that
            @_drop.Seller?.Name has already shopped for your portion.
        </p>
    </div>
}

@code {
    private enum CheckoutState { Reviewing, Processing, Succeeded }

    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public int? Quantity { get; set; }

    private FoodDrop? _drop;
    private int _quantity = 1;
    private string _paymentMethod = "Card";
    private CheckoutState _state = CheckoutState.Reviewing;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += OnUserChanged;
        _drop = await FoodDropService.GetByIdAsync(Id);
        _quantity = Math.Max(1, Quantity ?? 1);
    }

    private async void OnUserChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() => CurrentUser.OnChange -= OnUserChanged;

    private string PickupDayLabel()
    {
        if (_drop is null) return "";
        var days = (_drop.PickupWindowStart.ToLocalTime().Date - DateTime.Now.Date).Days;
        return days switch
        {
            0 => "Tonight",
            1 => "Tomorrow",
            _ => _drop.PickupWindowStart.ToLocalTime().ToString("dddd d MMM"),
        };
    }

    private async Task Submit()
    {
        if (_drop is null || CurrentUser.CurrentUser is null) return;

        _errorMessage = null;
        _state = CheckoutState.Processing;
        StateHasChanged();

        var creation = await OrderService.CreateOrderAsync(CurrentUser.CurrentUser.Id, Id, _quantity);
        if (!creation.Success)
        {
            _errorMessage = creation.Error switch
            {
                OrderCreationError.InsufficientPortions => "Sorry — someone just reserved the last of this batch. Try another quantity or check back later.",
                OrderCreationError.NotOrderable => "This food drop just stopped taking orders.",
                OrderCreationError.CannotOrderOwnListing => "You can't order your own food drop.",
                _ => "This food drop couldn't be found.",
            };
            _state = CheckoutState.Reviewing;
            return;
        }

        var confirmed = await OrderService.ConfirmPaymentAsync(creation.Order!.Id);
        if (confirmed is null || confirmed.Status != OrderStatus.Confirmed)
        {
            _errorMessage = "Payment couldn't be confirmed. Please try again.";
            _state = CheckoutState.Reviewing;
            return;
        }

        _state = CheckoutState.Succeeded;
        StateHasChanged();
        await Task.Delay(500); // let the "Reserved ✓" state register before navigating
        Nav.NavigateTo($"/orders/{confirmed.Id}");
    }
}
