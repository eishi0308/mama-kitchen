@page "/"
@inject IFoodDropService FoodDropService
@inject IFavoriteService FavoriteService
@inject IOrderService OrderService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Batch — homemade food near you</PageTitle>

@* An order you're waiting on outranks browsing. Surfacing it here means a
   buyer never has to go hunting for their pickup code or address. *@
@if (_activeOrder is { FoodDrop: not null } active)
{
    <a class="active-order-banner fade-in" href="/orders/@active.Id">
        <span class="banner-emoji">@active.FoodDrop.ImageEmoji</span>
        <div>
            <div class="banner-title">@ActiveOrderHeadline(active)</div>
            <div class="banner-sub">@ActiveOrderSubline(active)</div>
        </div>
        <Icon Name="arrow-right" Size="20" Class="banner-go" />
    </a>
}

<div class="mb-4">
    <h1 style="font-size:var(--fs-2xl); margin-bottom:0.15em;">What can you eat near you tonight?</h1>
    <p class="text-muted" style="font-size:var(--fs-md);">Homemade meals from home cooks nearby — pickup only, no delivery markup.</p>
</div>

@* A first-time visitor has no idea this is pickup-only, code-based, or that
   they're buying from a person. Three lines fixes that; it collapses once
   they've got the idea. *@
@if (_showHowItWorks)
{
    <div class="surface-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <strong style="font-size:var(--fs-sm);">How Batch works</strong>
            <button class="btn btn-sm btn-link p-0 text-muted" @onclick="() => _showHowItWorks = false">Hide</button>
        </div>
        <div class="hiw-strip">
            <div class="hiw-chip">
                <span class="hiw-chip-num">1</span>
                <span class="hiw-chip-text"><strong>Reserve a portion</strong><span>Pay up front so your cook only makes what sold</span></span>
            </div>
            <div class="hiw-chip">
                <span class="hiw-chip-num">2</span>
                <span class="hiw-chip-text"><strong>They cook it</strong><span>You watch it go from cooking to ready</span></span>
            </div>
            <div class="hiw-chip">
                <span class="hiw-chip-num">3</span>
                <span class="hiw-chip-text"><strong>Collect with a code</strong><span>Pick it up from their door — no delivery</span></span>
            </div>
        </div>
        <a class="btn btn-sm btn-outline-secondary mt-3" href="/how-it-works">See the full journey, both sides</a>
    </div>
}

<div class="mb-3">
    <input class="form-control form-control-lg" style="border-radius:var(--radius-md); max-width:480px;"
           placeholder="Search dish, cuisine or cook…" @bind="_query" @bind:event="oninput" @bind:after="ApplyFilters" />
</div>

<div class="chip-row mb-3">
    <button class="chip @(IsChipActive(FilterChip.All) ? "active" : "")" @onclick="() => SetChip(FilterChip.All)">All</button>
    <button class="chip @(IsChipActive(FilterChip.UnderFifteen) ? "active" : "")" @onclick="() => SetChip(FilterChip.UnderFifteen)">Under $15</button>
    <button class="chip @(IsChipActive(FilterChip.ReadySoon) ? "active" : "")" @onclick="() => SetChip(FilterChip.ReadySoon)">Ready soon</button>
    <button class="chip d-inline-flex align-items-center gap-1 @(IsChipActive(FilterChip.Vegetarian) ? "active" : "")" @onclick="() => SetChip(FilterChip.Vegetarian)"><Icon Name="leaf" Size="14" /> Vegetarian</button>
    <button class="chip @(IsChipActive(FilterChip.Halal) ? "active" : "")" @onclick="() => SetChip(FilterChip.Halal)">Halal</button>
    @foreach (var c in _categories)
    {
        <button class="chip @(_categoryId == c.Id ? "active" : "")" @onclick="() => ToggleCategory(c.Id)">@c.Icon @c.Name</button>
    }
</div>

@if (_drops is null)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @for (var i = 0; i < 8; i++)
        {
            <div class="col">
                <div class="skeleton" style="height:168px;"></div>
                <div class="skeleton mt-2" style="height:16px; width:60%;"></div>
                <div class="skeleton mt-2" style="height:14px; width:40%;"></div>
            </div>
        }
    </div>
}
else if (_drops.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="fork-knife" Size="26" /></div>
        <h3>Nothing nearby tonight — yet.</h3>
        <p>We're still growing in your area. Try widening your search, or check back soon.</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
            <button class="btn btn-primary" @onclick="ClearFilters">Clear filters</button>
        </div>
    </div>
}
else
{
    @foreach (var bucket in Buckets())
    {
        <h2 class="section-heading">@bucket.Label</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3 mb-2">
            @foreach (var drop in bucket.Drops)
            {
                <div class="col">
                    <MealCard Drop="drop" IsFavorite="_favoriteIds.Contains(drop.Id)"
                              ShowFavoriteButton="CurrentUser.CurrentUser is not null"
                              OnOpen="GoToDrop" OnToggleFavorite="ToggleFavorite" />
                </div>
            }
        </div>
    }
}

@code {
    private enum FilterChip { All, UnderFifteen, ReadySoon, Vegetarian, Halal }

    private List<FoodDrop>? _drops;
    private Order? _activeOrder;
    private List<Category> _categories = new();
    private HashSet<int> _favoriteIds = new();
    private string _query = "";
    private bool _showHowItWorks = true;
    private int? _categoryId;
    private FilterChip _activeChip = FilterChip.All;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += OnUserChanged;
        _categories = await FoodDropService.GetCategoriesAsync();
        await LoadFavorites();
        await LoadActiveOrder();
        await ApplyFilters();
    }

    private bool IsChipActive(FilterChip chip) => _activeChip == chip;

    private async Task SetChip(FilterChip chip)
    {
        _activeChip = chip;
        await ApplyFilters();
    }

    private async Task ToggleCategory(int id)
    {
        _categoryId = _categoryId == id ? null : id;
        await ApplyFilters();
    }

    private async Task ClearFilters()
    {
        _query = "";
        _categoryId = null;
        _activeChip = FilterChip.All;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        decimal? maxPrice = _activeChip == FilterChip.UnderFifteen ? 15 : null;
        DietaryLabel? dietary = _activeChip switch
        {
            FilterChip.Vegetarian => DietaryLabel.Vegetarian,
            FilterChip.Halal => DietaryLabel.Halal,
            _ => null,
        };

        var results = await FoodDropService.SearchAsync(_query, _categoryId, maxPrice, dietary);

        if (_activeChip == FilterChip.ReadySoon)
        {
            results = results.Where(d => d.IsOrderable && (d.OrderDeadline - DateTime.UtcNow).TotalMinutes <= 90).ToList();
        }

        _drops = results;
        StateHasChanged();
    }

    /// The single most imminent order the buyer is still waiting on.
    private async Task LoadActiveOrder()
    {
        _activeOrder = null;
        if (CurrentUser.CurrentUser is null) return;

        var orders = await OrderService.GetForBuyerAsync(CurrentUser.CurrentUser.Id);
        _activeOrder = orders
            .Where(o => o.Status is OrderStatus.Confirmed or OrderStatus.Preparing or OrderStatus.Ready)
            .OrderBy(o => o.FoodDrop?.PickupWindowStart ?? DateTime.MaxValue)
            .FirstOrDefault();
    }

    private static string ActiveOrderHeadline(Order o) => o.Status switch
    {
        OrderStatus.Ready => $"{o.FoodDrop!.Title} is ready to collect",
        OrderStatus.Preparing => $"{o.FoodDrop!.Seller?.Name} is cooking your {o.FoodDrop.Title}",
        _ => $"{o.FoodDrop!.Title} reserved from {o.FoodDrop.Seller?.Name}",
    };

    private static string ActiveOrderSubline(Order o)
    {
        var drop = o.FoodDrop!;
        var mins = (int)(drop.PickupWindowStart - DateTime.UtcNow).TotalMinutes;
        var when = mins switch
        {
            <= 0 => "Pickup window is open now",
            < 60 => $"Pickup in {mins} min",
            < 60 * 24 => $"Pickup in {mins / 60}h {mins % 60}m",
            _ => $"Pickup {drop.PickupWindowStart.ToLocalTime():ddd d MMM}",
        };
        return $"{when} · {drop.PickupLocation?.Suburb} · code {o.PickupCode}";
    }

    private async Task LoadFavorites()
    {
        if (CurrentUser.CurrentUser is null) return;
        var favs = await FavoriteService.GetFavoritesAsync(CurrentUser.CurrentUser.Id);
        _favoriteIds = favs.Select(f => f.Id).ToHashSet();
    }

    private async Task ToggleFavorite(int foodDropId)
    {
        if (CurrentUser.CurrentUser is null) return;
        await FavoriteService.ToggleAsync(CurrentUser.CurrentUser.Id, foodDropId);
        if (!_favoriteIds.Add(foodDropId)) _favoriteIds.Remove(foodDropId);
    }

    private void GoToDrop(int id) => Nav.NavigateTo($"/food/{id}");

    private record Bucket(string Label, List<FoodDrop> Drops);

    private List<Bucket> Buckets()
    {
        if (_drops is null) return new();

        // Bucketed by hours-until-pickup, not calendar-date equality — a
        // calendar-day comparison breaks the moment "3 hours from now" rolls
        // past local midnight (seed data created at 9pm reads as "tomorrow"
        // for a pickup that's really still tonight). See brief Section 38:
        // "timezone/date issues".
        var tonight = new List<FoodDrop>();
        var tomorrow = new List<FoodDrop>();
        var later = new List<FoodDrop>();

        foreach (var d in _drops)
        {
            var hoursUntil = (d.PickupWindowStart - DateTime.UtcNow).TotalHours;
            if (hoursUntil < 15) tonight.Add(d);
            else if (hoursUntil < 39) tomorrow.Add(d);
            else later.Add(d);
        }

        var buckets = new List<Bucket>();
        if (tonight.Count > 0) buckets.Add(new("Available tonight", tonight));
        if (tomorrow.Count > 0) buckets.Add(new("Tomorrow", tomorrow));
        if (later.Count > 0) buckets.Add(new("This weekend", later));
        return buckets;
    }

    private async void OnUserChanged()
    {
        await LoadFavorites();
        await LoadActiveOrder();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= OnUserChanged;
    }
}
