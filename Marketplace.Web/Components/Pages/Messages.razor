@page "/messages"
@page "/messages/{FoodDropId:int}/{OtherUserId:int}"
@attribute [Authorize]
@inject IMessageService MessageService
@inject IFoodDropService FoodDropService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@implements IDisposable

@* Shared by both worlds: the same thread is a buyer asking about allergens and
   a cook answering it. Which side you're on only changes the labels. *@

<PageTitle>Messages — Batch</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title"><Icon Name="chat" Size="22" /> Messages</h1>
        <div class="page-sub">Questions about a specific food drop — allergens, timing, portion size.</div>
    </div>
</div>

@if (_conversations.Count == 0 && !HasThread)
{
    <div class="empty-state">
        <div class="empty-state-icon"><Icon Name="chat" Size="26" /></div>
        <h3>No conversations yet</h3>
        <p>
            @(CurrentUser.Mode == AppMode.Cook
                ? "When a buyer asks about one of your food drops, it'll appear here."
                : "Open a food drop and ask the cook anything before you reserve.")
        </p>
        <a class="btn btn-primary" href="@(CurrentUser.Mode == AppMode.Cook ? "/kitchen" : "/")">
            @(CurrentUser.Mode == AppMode.Cook ? "Your kitchen" : "Browse food nearby")
        </a>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-md-4">
            <div class="d-flex flex-column gap-2">
                @foreach (var c in _conversations)
                {
                    <a class="conversation-card @(IsActive(c) ? "active" : "")"
                       href="/messages/@c.FoodDropId/@c.OtherUserId">
                        <div class="d-flex justify-content-between align-items-baseline gap-2">
                            <strong class="text-truncate">@c.OtherUserAvatar @c.OtherUserName</strong>
                            <small class="text-muted nowrap">@ShortDate(c.LastMessageAt)</small>
                        </div>
                        <div class="small text-truncate" style="color:var(--color-text-faint);">re: @c.FoodDropTitle</div>
                        <div class="small text-truncate text-muted">@c.LastMessage</div>
                    </a>
                }
            </div>
        </div>

        <div class="col-md-8">
            @if (HasThread)
            {
                <div class="surface-card p-3 mb-2">
                    @if (_threadDrop is not null)
                    {
                        <div class="d-flex align-items-center gap-2 pb-2 mb-3" style="border-bottom:1px solid var(--color-border);">
                            <span style="font-size:1.5rem;">@_threadDrop.ImageEmoji</span>
                            <div class="flex-grow-1" style="min-width:0;">
                                <a href="/food/@_threadDrop.Id" class="fw-bold text-decoration-none text-truncate d-block" style="color:inherit;">
                                    @_threadDrop.Title
                                </a>
                                <div class="text-muted small">
                                    Pickup @_threadDrop.PickupWindowStart.ToLocalTime().ToString("ddd d MMM, h:mm tt")
                                    · $@_threadDrop.Price.ToString("0.##")
                                </div>
                            </div>
                            @if (_threadDrop.IsOrderable && _threadDrop.SellerId != CurrentUser.CurrentUser.Id)
                            {
                                <a class="btn btn-sm btn-primary nowrap" href="/food/@_threadDrop.Id">Reserve</a>
                            }
                        </div>
                    }

                    <div class="thread" style="max-height:420px; overflow-y:auto;">
                        @if (_thread.Count == 0)
                        {
                            <p class="text-muted small mb-0">No messages in this conversation yet.</p>
                        }
                        @foreach (var m in _thread)
                        {
                            <div class="bubble @(m.SenderId == CurrentUser.CurrentUser.Id ? "bubble-mine" : "bubble-theirs")">
                                @m.Body
                                <span class="bubble-time">@m.SentAt.ToLocalTime().ToString("d MMM, h:mm tt")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="input-group">
                    <input class="form-control" @bind="_draft" @onkeyup="HandleKeyUp"
                           placeholder="@(CurrentUser.Mode == AppMode.Cook ? "Reply to your buyer…" : "Ask about allergens, timing, portion size…")" />
                    <button class="btn btn-primary" @onclick="Send">Send</button>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><Icon Name="chat" Size="26" /></div>
                    <h3>Pick a conversation</h3>
                    <p>Choose one on the left to read it.</p>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? FoodDropId { get; set; }
    [Parameter] public int? OtherUserId { get; set; }

    private List<ConversationSummary> _conversations = new();
    private List<Message> _thread = new();
    private FoodDrop? _threadDrop;
    private string _draft = "";

    private bool HasThread => FoodDropId.HasValue && OtherUserId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += OnUserChanged;
        await LoadConversations();
        await LoadThread();
    }

    protected override async Task OnParametersSetAsync() => await LoadThread();

    private async Task LoadConversations()
    {
        if (CurrentUser.CurrentUser is not null)
            _conversations = await MessageService.GetConversationsAsync(CurrentUser.CurrentUser.Id);
    }

    private async Task LoadThread()
    {
        if (CurrentUser.CurrentUser is null || !HasThread) { _threadDrop = null; return; }
        _thread = await MessageService.GetThreadAsync(FoodDropId!.Value, CurrentUser.CurrentUser.Id, OtherUserId!.Value);
        // The dish is the whole context of the conversation — without it a
        // thread reads as a stranger asking "is it gluten free?" about nothing.
        _threadDrop = await FoodDropService.GetByIdAsync(FoodDropId.Value);
    }

    private bool IsActive(ConversationSummary c) => c.FoodDropId == FoodDropId && c.OtherUserId == OtherUserId;

    private static string ShortDate(DateTime utc)
    {
        var local = utc.ToLocalTime();
        return local.Date == DateTime.Now.Date ? local.ToString("h:mm tt") : local.ToString("d MMM");
    }

    private async void OnUserChanged()
    {
        await LoadConversations();
        await LoadThread();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    private async Task Send()
    {
        if (CurrentUser.CurrentUser is null || !HasThread || string.IsNullOrWhiteSpace(_draft)) return;
        await MessageService.SendAsync(FoodDropId!.Value, CurrentUser.CurrentUser.Id, OtherUserId!.Value, _draft);
        _draft = "";
        await LoadThread();
        await LoadConversations();
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= OnUserChanged;
    }
}
