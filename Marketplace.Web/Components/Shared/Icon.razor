@* Minimal inline-SVG icon system — stroke-based, 1.75px stroke, rounded caps,
   24x24 viewBox, matches Phosphor's "regular" outline weight. Replaces emoji
   as UI chrome (nav, badges, buttons) per world-class UI checklist: emojis
   are font-dependent, inconsistent across platforms, and can't be themed. *@

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="@(Filled ? "currentColor" : "none")" stroke="currentColor" stroke-width="@StrokeWidth"
     stroke-linecap="round" stroke-linejoin="round" class="@Class" aria-hidden="true">
    @switch (Name)
    {
        case "house":
            <path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v9a1 1 0 0 0 1 1H9a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h2.5a1 1 0 0 0 1-1v-9" />
            break;
        case "heart":
            <path d="M12 20.5s-7.5-4.6-9.8-9.3C.8 7.8 2.3 4.5 5.6 3.8c2-.4 4 .5 5 2.1 1-1.6 3-2.5 5-2.1 3.3.7 4.8 4 3.4 7.4-2.3 4.7-9.8 9.3-9.8 9.3-.7.4-1.2.4-2 0Z" />
            break;
        case "receipt":
            <path d="M6 3h12v18l-2.5-1.6L13 21l-1.5-1.6L10 21l-2.5-1.6L6 21V3Z" /><path d="M9 8h6M9 12h6M9 16h3" />
            break;
        case "bag":
            <path d="M7 8V6.5a5 5 0 0 1 10 0V8" /><path d="M4.5 8h15l-1 12.5a1.5 1.5 0 0 1-1.5 1.5h-10a1.5 1.5 0 0 1-1.5-1.5L4.5 8Z" />
            break;
        case "chef-hat":
            <path d="M7 12.5V19a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6.5" /><path d="M6 9.5a3 3 0 0 1 2-5.6A3.5 3.5 0 0 1 12 3a3.5 3.5 0 0 1 4 .9 3 3 0 0 1 2 5.6 3 3 0 0 1-1 5.9H7a3 3 0 0 1-1-5.9Z" />
            break;
        case "map-pin":
            <path d="M12 21s7-6.3 7-11.5a7 7 0 1 0-14 0C5 14.7 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.3" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" />
            break;
        case "magnifying-glass":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4.3-4.3" />
            break;
        case "check":
            <path d="M4 12.5 9.5 18 20 6" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" /><path d="m8 12.5 2.5 2.5L16 9.5" />
            break;
        case "list":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "arrow-left":
            <path d="M19 12H5M11 6l-6 6 6 6" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "caret-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "tag":
            <path d="M3 11.5V5a1 1 0 0 1 1-1h6.5a1 1 0 0 1 .7.3l9 9a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-9-9a1 1 0 0 1-.3-.7Z" /><circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
            break;
        case "funnel":
            <path d="M3 5h18l-7 8v6l-4 2v-8L3 5Z" />
            break;
        case "warning":
            <path d="M12 3 22 20H2L12 3Z" /><path d="M12 10v4" /><circle cx="12" cy="17" r="0.8" fill="currentColor" stroke="none" />
            break;
        case "storefront":
            <path d="M4 9.5 5 4h14l1 5.5" /><path d="M4 9.5a2.2 2.2 0 0 0 4.4 0 2.2 2.2 0 0 0 4.4 0 2.2 2.2 0 0 0 4.4 0 2.2 2.2 0 0 0 4.4 0" /><path d="M5.5 10v10h13V10" /><path d="M10 20v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5" />
            break;
        case "fork-knife":
            <path d="M7 3v7a2 2 0 0 1-2 2 2 2 0 0 1-2-2V3M5 12v9" /><path d="M16 3c-1.5 0-3 2-3 5s1.5 5 3 5M16 3v16" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 20.5c0-3.6 3.6-6.5 8-6.5s8 2.9 8 6.5" />
            break;
        case "spinner":
            <circle cx="12" cy="12" r="9" stroke-opacity="0.25" /><path d="M21 12a9 9 0 0 0-9-9" />
            break;
        case "leaf":
            <path d="M5 19c8 1 13-4 14-14-10 0-15 5-14 14Z" /><path d="M5 19c2-4 5-7 9-9" />
            break;
        case "moon-star":
            <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
            break;
        case "chat":
            <path d="M4 5.5h16a1 1 0 0 1 1 1V16a1 1 0 0 1-1 1H9l-4.5 4V17H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9" rx="1.5" /><path d="M8 11V7.5a4 4 0 0 1 8 0V11" />
            break;
        case "star":
            <path d="m12 3 2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L12 16.9l-5.6 3.2 1.4-6.3-4.8-4.3 6.4-.6L12 3Z" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public double StrokeWidth { get; set; } = 1.75;
}
