@inject NavigationManager Nav

@* Sends an anonymous visitor to /login carrying where they were trying to go,
   so signing in resumes the journey instead of dumping them on the home page.
   forceLoad: false — this is an in-app navigation, not an auth round trip. *@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
